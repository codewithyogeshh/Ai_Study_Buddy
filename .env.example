# ---------------------------------------------------------------------------
# AI Study Buddy — backend environment
# Copy to .dev.vars for local development, or set these in your host's
# environment/secret store. Never commit real values.
# ---------------------------------------------------------------------------

# MongoDB connection string from MongoDB Atlas (mongodb+srv://...)
# NOTE: this deployment stores data in D1 (SQLite). See README "Runtime note".
MONGODB_URI=

# Secret used to sign JWTs. Use at least 32 random bytes.
JWT_SECRET=

# Google Gemini API key — https://aistudio.google.com/apikey
# Server-side only. It is never sent to the browser.
GEMINI_API_KEY=

# Gemini model id. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Allowed frontend origin(s) for CORS, comma separated.
FRONTEND_URL=http://localhost:5173

# Backend port (Workers runtime uses the platform port).
PORT=8787
