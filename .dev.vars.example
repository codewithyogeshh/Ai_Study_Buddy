# Local development secrets for `wrangler`/Vite dev. Copy to `.dev.vars`.
# `.dev.vars` is gitignored — never commit real secrets.

# Required. Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Required for AI features. Get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite (fast, recommended for new projects).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Comma-separated allowed browser origins for cross-origin API calls.
# Same-origin deployment needs nothing here. Localhost is always allowed.
FRONTEND_URL=http://localhost:5364

# Optional. AI requests per user per UTC day (default 300).
AI_DAILY_LIMIT=300
